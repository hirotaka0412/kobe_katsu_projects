{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kobe-katsu-projects", "main": "worker/index.ts", "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {"directory": "./root", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "vars": {"AI_ENABLED":"true", "GEMINI_MODEL":"gemini-3.8-flash", "TURNSTILE_SITE_KEY":"0x4AAAAAAFo4MR3K8A8LdTJc", "ALLOWED_ORIGINS":"https://hirotaka0412.github.io", "QUESTION_LIMIT":"2000", "SELECTION_LIMIT":"4000", "HISTORY_TURNS":"10", "OUTPUT_TOKENS":"2048", "DAILY_LIMIT":"300"},
  "ratelimits": [{"name":"CHAT_RATE", "namespace_id":"1001", "simple":{"limit":10,"period":60}}],
  "durable_objects":{"bindings":[{"name":"DAILY_QUOTA","class_name":"DailyQuota"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["DailyQuota"]}],
  "observability":{"enabled":true}
}
